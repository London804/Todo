{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "TodoApp",
    "Audience": "TodoApp",
    "ExpiryMinutes": 60
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@todoapp.local",
    "FromName": "TodoApp",
    "UseStartTls": false
  },
  "AllowedHosts": "*"
}
